# Environment variables template
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED: Azure AD Configuration
# ============================================================
# Required for Azure AD authentication (SSO)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# Azure Shared Image Gallery (for Azure VM deployment)
AZURE_SHARED_IMAGE_SUBSCRIPTION_ID=your-shared-image-subscription-id
AZURE_SHARED_IMAGE_RESOURCE_GROUP=ISD-eCloud
AZURE_SHARED_IMAGE_GALLERY=eCloud_Images

# ============================================================
# OPTIONAL: AWS Configuration
# ============================================================
AWS_REGION=us-west-2
AWS_SSO_INSTANCE_ARN=arn:aws:sso:::instance/ssoins-xxxxx
AWS_SSO_APP_OBJECT_ID=your-app-object-id
# Optional: If not using IAM role
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token

# ============================================================
# GCP Configuration - Choose ONE of the following options:
# ============================================================

# OPTION 1: Google OAuth (Quick Setup, Separate Login)
# - Works immediately without GCP WIF setup
# - Requires users to login separately with Google for GCP access
# - Recommended for: Quick testing, mixed authentication requirements
#
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/gcp/oauth2callback

# OPTION 2: GCP Workload Identity Federation (True SSO with Azure AD)
# - Single sign-on: Users login once with Azure AD for both Azure and GCP
# - Requires GCP WIF configuration (see SSO_CROSS_CLOUD_SETUP.md)
# - Recommended for: Production, unified SSO experience
#
# GCP_PROJECT_NUMBER=your-gcp-project-number
# GCP_WIF_POOL_ID=azure-ad-pool
# GCP_WIF_PROVIDER_ID=azure-ad-provider
# Optional: Service account for impersonation
# GCP_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com

# GCP Custom Images Configuration (REQUIRED for GCP VM deployment)
# - Set this to your GCP project ID where custom images are stored
# - Custom images should be available as image families in this project
GCP_CUSTOM_IMAGE_PROJECT=your-gcp-project-id

# NOTE: You can configure both options - the application will use WIF if
# configured, and fall back to Google OAuth if WIF fails.

# ============================================================
# OCI Configuration (Optional)
# ============================================================
# Enable OCI support in the unified production portal
# OCI_ENABLED=false
#
# Comma-separated root tenancies shown in the UI
# OCI_TENANCY_KEYS=isdecloud,lacounty
#
# Per-root-tenancy settings
# OCI_ISDECLOUD_DISPLAY_NAME=isdecloud
# OCI_ISDECLOUD_TENANCY_OCID=ocid1.tenancy.oc1..example
# OCI_ISDECLOUD_USER_OCID=ocid1.user.oc1..example
# OCI_ISDECLOUD_FINGERPRINT=12:34:56:78:90:ab:cd:ef:12:34:56:78:90:ab:cd:ef
# OCI_ISDECLOUD_REGION=us-phoenix-1
# OCI_ISDECLOUD_IMAGE_COMPARTMENT_OCID=ocid1.compartment.oc1..example
# Choose one key format:
# OCI_ISDECLOUD_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# OCI_ISDECLOUD_PRIVATE_KEY_B64=base64-encoded-private-key
# OCI_ISDECLOUD_PRIVATE_KEY_PASSPHRASE=
#
# OCI_LACOUNTY_DISPLAY_NAME=lacounty
# OCI_LACOUNTY_TENANCY_OCID=ocid1.tenancy.oc1..example
# OCI_LACOUNTY_USER_OCID=ocid1.user.oc1..example
# OCI_LACOUNTY_FINGERPRINT=12:34:56:78:90:ab:cd:ef:12:34:56:78:90:ab:cd:ef
# OCI_LACOUNTY_REGION=us-phoenix-1
# OCI_LACOUNTY_IMAGE_COMPARTMENT_OCID=ocid1.compartment.oc1..example
# OCI_LACOUNTY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# OCI_LACOUNTY_PRIVATE_KEY_B64=base64-encoded-private-key
# OCI_LACOUNTY_PRIVATE_KEY_PASSPHRASE=
#
# Optional department-based tenancy filtering:
# Add portal.portal_department_resources rows with cloud='oci' and subscription_id
# equal to the tenancy key (for example: isdecloud or lacounty).
#
# Optional shared-image source override for all OCI deployments:
# When set, /api/oci/images always reads from this source tenancy/compartment
# regardless of selected target tenancy or compartment.
# OCI_SHARED_IMAGE_TENANCY_KEY=isdecloud
# OCI_SHARED_IMAGE_COMPARTMENT_OCID=ocid1.compartment.oc1..lac-certifiedimages
#
# ============================================================
# Application Configuration
# ============================================================
# IMPORTANT: Change this to a strong random value in production!
SESSION_SECRET=your-very-strong-random-secret-key-change-this-in-production
TERRAFORM_BIN=/usr/bin/terraform
PORT=8000

# ============================================================
# Cache TTL Configuration (Optional)
# ============================================================
# SP_SUBS_CACHE_TTL=300
# USER_SUBS_CACHE_TTL=180
# SUBS_RG_CACHE_TTL=120

# ============================================================
# Cherwell Integration Configuration (Optional)
# ============================================================
# Enable Cherwell integration for post-deployment task creation
CHERWELL_ENABLED=false

# Cherwell API Configuration
# IMPORTANT: Set the correct environment URL based on your needs
# Test Environment (for development and testing):
# CHERWELL_BASE_URL=https://smstst.isd.lacounty.gov/CherwellAPI
# Production Environment:
# CHERWELL_BASE_URL=https://smstest.isd.lacounty.gov/CherwellAPI

# Authentication credentials (uncomment and set your values)
# CHERWELL_CLIENT_GUID=your-cherwell-client-guid
# CHERWELL_USER=your-cherwell-username
# CHERWELL_PASSWORD=your-cherwell-password

# SSL Certificate Verification (default: true)
# Set to false only for debugging SSL issues
# HTTP_VERIFY=true

# Token retry configuration (optional)
# CHERWELL_TOKEN_TIMEOUT=30
# CHERWELL_TOKEN_RETRIES=3
# CHERWELL_TOKEN_BACKOFF=1.5

